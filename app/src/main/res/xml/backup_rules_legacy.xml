<full-backup-content>
    <exclude
        domain="file"
        path="Downloads/" />
    <exclude
        domain="external"
        path="Downloads/" />
    <!-- Auth tokens/session live in their own prefs file: exclude exactly that file
         so a backup never carries credentials, without wiping settings. -->
    <exclude
        domain="sharedpref"
        path="auth_prefs.xml" />
</full-backup-content>
