<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="Downloads/" />
        <exclude
            domain="external"
            path="Downloads/" />
        <!-- Auth tokens/session live in their own prefs file: exclude exactly that
             file so a backup never carries credentials, without wiping settings. -->
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="Downloads/" />
        <exclude
            domain="external"
            path="Downloads/" />
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
