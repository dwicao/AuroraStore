<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="Downloads/" />
        <exclude
            domain="external"
            path="Downloads/" />
        <!-- Auth tokens/session live in their own prefs file: exclude exactly that
             file so a backup never carries credentials, without wiping settings. -->
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />
        <!-- The account table stores the same tokens (aasToken/authToken/authDataJson)
             as auth_prefs.xml; the DB is not encrypted at rest, so it must not ride
             along in a backup either (it subsumes the auth_prefs exclusions). -->
        <exclude
            domain="database"
            path="aurora_database" />
        <exclude
            domain="database"
            path="aurora_database-wal" />
        <exclude
            domain="database"
            path="aurora_database-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="Downloads/" />
        <exclude
            domain="external"
            path="Downloads/" />
        <exclude
            domain="sharedpref"
            path="auth_prefs.xml" />
        <exclude
            domain="database"
            path="aurora_database" />
        <exclude
            domain="database"
            path="aurora_database-wal" />
        <exclude
            domain="database"
            path="aurora_database-shm" />
    </device-transfer>
</data-extraction-rules>
